{% extends 'base.html.twig' %}

{% block title %}{{ tileset.name }} · {{ edit ? 'Éditeur de tiles'|trans : 'Tiles'|trans }} · Sonic PHP{% endblock %}
{% block description %}{{ tileset.zone ? 'Les blocs de la zone %name% du jeu, pour l\'éditeur de niveau de Sonic PHP.'|trans({'%name%': tileset.name}) : 'Des tiles pour l\'éditeur de niveau de Sonic PHP, faites par %name%.'|trans({'%name%': tileset.user.username}) }}{% endblock %}
{% block robots %}{{ tileset.public and not edit ? 'index, follow' : 'noindex' }}{% endblock %}
{% block main_class %}{{ edit ? 'full' : 'wide' }}{% endblock %}

{% import '_parts/people.html.twig' as people %}
{% block body %}
{% if not edit %}
    <section class="panel wide">
        <div class="lv-head">
            <div>
                <h1>{{ tileset.name }}</h1>
                <p class="muted">
                    {% if tileset.zone %}{{ 'Zone du jeu'|trans }}{% else %}{{ 'par'|trans }} {{ people.user(tileset.user) }}{% endif %} ·
                    {{ tileset.count }} {{ 'blocs'|trans }} · {{ used > 1 ? '%n% niveaux'|trans({'%n%': used}) : '%n% niveau'|trans({'%n%': used}) }}
                    {% if not tileset.public %}· <span class="badge off">{{ 'Privé'|trans }}</span>{% endif %}
                </p>
            </div>
            <div class="lv-actions">
                {% if creation_info(tileset).canEdit %}
                    <a class="pill-button" href="{{ path('tileset_edit', {id: tileset.id}) }}">{{ 'Éditer'|trans }}</a>
                {% elseif app.user and tileset.canUse(app.user) %}
                    <form method="post" action="{{ path('tileset_new') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
                        <input type="hidden" name="from" value="{{ tileset.id }}">
                        <button class="pill-button pc-hide" type="submit" title="{{ 'Faire ta propre copie, que tu modifies comme tu veux. Le créateur reste cité.'|trans }}">{{ 'Forker'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
        <div class="ts-view"><img src="{{ path('tileset_png', {id: tileset.id, v: tileset.updatedAt.timestamp}) }}" alt="{{ tileset.name }}"></div>
        <p class="small muted">{{ 'Chaque bloc fait 32×32 pixels. Un niveau peut utiliser ces tiles si elles sont publiques.'|trans }} <a href="{{ path('editor') }}">{{ 'L\'éditeur'|trans }}</a></p>
    </section>
    {% include '_parts/credits.html.twig' with {creation: tileset} only %}
{% else %}
    <p class="pc-only panel wide">{{ 'L\'éditeur se fait sur un ordinateur, avec une souris et un clavier.'|trans }}
        <a href="{{ path('tileset', {id: tileset.id}) }}">{{ 'Voir les tiles'|trans }}</a></p>
    <section id="tile-editor" class="editor pc-hide" {{ live_attributes(tileset, restored) }}
             data-json="{{ path('tileset_json', {id: tileset.id, version: restored}) }}" data-save="{{ path('tileset_save', {id: tileset.id}) }}"
             data-tileset-json="{{ path('tileset_json', {id: 0})|replace({'/0.json': '/ID.json'}) }}"
             data-token="{{ csrf_token('editor') }}" data-shapes="{{ asset('data/solidity-shapes.json') }}"
             data-i18n="{{ {unsaved: 'Modifications non enregistrées'|trans, cloneFirst: 'Alt+clic : choisis d\'abord la source à copier.'|trans, saving: 'Enregistrement…'|trans, saved: 'Enregistré'|trans,
                 error: 'Erreur'|trans, block: 'Bloc'|trans, shape: 'Forme'|trans, copied: 'Bloc copié'|trans,
                 full: '256 blocs au plus'|trans, imported: '%n% blocs ajoutés'|trans, other: 'autre'|trans}|json_encode }}">
        <div class="ed-bar">
            <input type="text" name="name" value="{{ tileset.name }}" maxlength="40" aria-label="{{ 'Nom'|trans }}">
            <label><input type="checkbox" name="public" {{ tileset.public ? 'checked' }}> {{ 'Public'|trans }}</label>
            <span class="small muted">{{ used > 1 ? '%n% niveaux'|trans({'%n%': used}) : '%n% niveau'|trans({'%n%': used}) }}</span>
            <span class="ed-sep"></span>
            <button type="button" class="pill-button ed-undo" title="Ctrl+Z">↶</button>
            <button type="button" class="pill-button ed-redo" title="Ctrl+Y">↷</button>
            <span class="ed-sep"></span>
            <span class="ed-status" role="status"></span>
            <button type="button" class="play small ed-save" title="Ctrl+S">{{ 'Enregistrer'|trans }}</button>
        </div>
        <div class="te-main">
            <div class="te-list">
                <h3>{{ 'Blocs'|trans }} <small class="te-count muted"></small></h3>
                <canvas class="te-sheet"></canvas>
                <div class="ed-row">
                    <button type="button" class="pill-button te-add">+ {{ 'Bloc vide'|trans }}</button>
                    <button type="button" class="pill-button te-duplicate">{{ 'Dupliquer'|trans }}</button>
                    <button type="button" class="pill-button te-remove" title="{{ 'Les niveaux utilisent les blocs par leur numéro : seul le dernier peut être enlevé.'|trans }}">{{ 'Enlever le dernier'|trans }}</button>
                </div>
                <h3>{{ 'Importer'|trans }}</h3>
                <label class="small">{{ 'Une image PNG (découpée en blocs de 32×32, ajoutés à la fin)'|trans }}
                    <input type="file" name="import" accept="image/png,image/gif,image/webp"></label>
                <label class="small">{{ 'Ou des blocs d\'autres tiles (clique ceux à ajouter)'|trans }}
                    <select name="other">
                        <option value="">—</option>
                        {% for other in usable %}<option value="{{ other.id }}">{{ other.name }}{% if other.user and other.user != app.user %} ({{ other.user.username }}){% endif %}</option>{% endfor %}
                    </select></label>
                <canvas class="te-other" hidden></canvas>
            </div>
            <div class="te-draw">
                <h3 class="te-current"></h3>
                <canvas class="te-pixels"></canvas>
                <div class="ed-tools">
                    <button type="button" data-tool="pencil" title="B">✎ {{ 'Crayon'|trans }}</button>
                    <button type="button" data-tool="fill" title="F">◧ {{ 'Remplir'|trans }}</button>
                    <button type="button" data-tool="picker" title="I">⌖ {{ 'Pipette'|trans }}</button>
                    <button type="button" data-tool="eraser" title="E">⌫ {{ 'Gomme'|trans }}</button>
                    <button type="button" data-tool="clone" title="K">⧉ {{ 'Clone'|trans }}</button>
                </div>
                <div class="ed-clone" hidden>
                    <p class="small">{{ 'Alt+clic sur le dessin ou sur la liste des blocs : la source (encadrée en bleu, même dans un autre bloc). Puis peins le bloc : ses pixels sont recopiés.'|trans }}</p>
                    <div class="ed-row">
                        <label class="small">{{ 'Taille'|trans }} <select name="clone-size">
                            {% for n in [1, 2, 4, 8, 16] %}<option value="{{ n }}"{% if n == 4 %} selected{% endif %}>{{ n }}×{{ n }} px</option>{% endfor %}
                        </select></label>
                        <label class="small" title="{{ 'Coché : la source garde la même distance d\'un trait à l\'autre. Décoché : chaque trait repart de la source.'|trans }}"><input type="checkbox" name="clone-aligned" checked> {{ 'Aligné'|trans }}</label>
                    </div>
                </div>
                <div class="ed-row">
                    <button type="button" class="pill-button te-flip-h" title="{{ 'Miroir'|trans }}">⇋</button>
                    <button type="button" class="pill-button te-flip-v" title="{{ 'Retourner'|trans }}">⇵</button>
                    <button type="button" class="pill-button te-rotate" title="{{ 'Tourner'|trans }}">⟳</button>
                    <button type="button" class="pill-button te-copy" title="Ctrl+C">{{ 'Copier'|trans }}</button>
                    <button type="button" class="pill-button te-paste" title="Ctrl+V">{{ 'Coller'|trans }}</button>
                    <button type="button" class="pill-button te-clear">{{ 'Vider'|trans }}</button>
                </div>
            </div>
            <div class="te-props">
                <h3>{{ 'Couleur'|trans }}</h3>
                <div class="ed-row"><input type="color" name="colour" aria-label="{{ 'Couleur'|trans }}"> <small class="muted">{{ 'clic droit sur le dessin : prendre sa couleur'|trans }}</small></div>
                <div class="te-swatches" aria-label="{{ 'Les 64 couleurs de la Master System'|trans }}"></div>
                <h3>{{ 'Aperçu'|trans }}</h3>
                <canvas class="te-preview" width="192" height="192"></canvas>
                <h3>{{ 'Collision'|trans }}</h3>
                <label class="small"><input type="checkbox" data-toggle="shape" checked> {{ 'montrer sur le dessin'|trans }}</label>
                <label class="small"><input type="checkbox" name="front"> {{ 'Devant Sonic (Sonic passe derrière)'|trans }}</label>
                <label class="small">{{ 'Comportement'|trans }}
                    <select name="behaviour">
                        {% for value, name in behaviours %}<option value="{{ value }}">{{ name|trans }}</option>{% endfor %}
                    </select></label>
                <p class="small muted">{{ 'Les blocs 121, 122 et 123 sont des anneaux (à gauche, à droite, les deux), dessinés sur le bloc 120.'|trans }}</p>
                <p class="small muted">{{ 'En rouge : là où Sonic marche. Choisis une forme du jeu, ou dessine la tienne.'|trans }}</p>
                <label class="small"><input type="checkbox" name="paint-mask"> {{ 'Dessiner la collision : le crayon, le remplissage et la gomme changent les zones rouges'|trans }}</label>
                <div class="te-mask" hidden>
                    <p class="small"><span class="badge">{{ 'Collision dessinée'|trans }}</span>
                        <button type="button" class="pill-button te-mask-reset">{{ 'Revenir à une forme du jeu'|trans }}</button></p>
                </div>
                <label class="small"><input type="checkbox" name="w-floor"> {{ 'Sol : Sonic marche dessus'|trans }}</label>
                <label class="small"><input type="checkbox" name="w-walls"> {{ 'Murs : bloque Sonic sur les côtés'|trans }}</label>
                <label class="small"><input type="checkbox" name="w-ceiling"> {{ 'Plafond : bloque Sonic par en dessous'|trans }}</label>
                <div class="te-shapes"></div>
                {% if tileset.isOwnedBy(app.user) %}
                <form method="post" action="{{ path('tileset_delete', {id: tileset.id}) }}" onsubmit="return confirm(this.dataset.confirm)"
                      data-confirm="{{ 'Supprimer ces tiles pour de bon ?'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
                    <button class="pill-button danger" type="submit"{% if used %} disabled title="{{ 'Ces tiles servent à des niveaux : elles ne peuvent pas être supprimées.'|trans }}"{% endif %}>{{ 'Supprimer ces tiles'|trans }}</button>
                </form>
                {% endif %}
            </div>
        </div>
    </section>
{% endif %}
{% endblock %}

{% block scripts %}
    {% if edit %}
        <script src="{{ asset('js/level-view.js') }}" defer></script>
        <script src="{{ asset('js/editor-live.js') }}" defer></script><script src="{{ asset('js/editor-tiles.js') }}" defer></script>
    {% endif %}
{% endblock %}
