{% extends 'base.html.twig' %}

{% block title %}{{ level.name }} · {{ edit ? 'Éditeur de niveau'|trans : 'Niveau'|trans }} · Sonic PHP{% endblock %}
{% block description %}{{ 'Un niveau de Sonic fait par %name% dans l\'éditeur de Sonic PHP (%w%×%h% blocs, tiles %tiles%).'|trans({'%name%': level.user.username, '%w%': level.width, '%h%': level.height, '%tiles%': level.tileset.name}) }}{% endblock %}
{% block og_image %}{{ app.request.schemeAndHttpHost ~ path('level_png', {id: level.id, v: level.updatedAt.timestamp}) }}{% endblock %}
{% block robots %}{{ level.public and not edit ? 'index, follow' : 'noindex' }}{% endblock %}
{% block main_class %}{{ edit ? 'full' : 'wide' }}{% endblock %}

{% import '_parts/people.html.twig' as people %}
{% block body %}
{% if not edit %}
    {% include '_parts/trashed.html.twig' with {creation: level} only %}
    <section class="panel wide" data-level-viewer data-json="{{ path('level_json', {id: level.id}) }}"
             data-sonic="{{ asset('img/sonics.png') }}" data-shapes="{{ asset('data/solidity-shapes.json') }}"
             data-icons="{{ asset('data/object-icons.json') }}" data-icons-image="{{ asset('img/objects.png') }}"
             data-objects="{{ objects|json_encode }}">
        <div class="lv-head">
            <div>
                <h1>{{ level.name }}</h1>
                <p class="muted">
                    {{ 'par'|trans }} {{ people.user(level.user) }}{% set from = creation_info(level).from %}{% if from %} ({{ 'fork de'|trans }} {{ people.creation('level', from) }} {{ 'de'|trans }} {{ people.user(from.user) }}){% endif %} · {{ level.width }}×{{ level.height }} {{ 'blocs'|trans }} ·
                    {{ 'tiles'|trans }} <a href="{{ path('tileset', {id: level.tileset.id}) }}">{{ level.tileset.name }}</a> ·
                    {{ level.objects|length }} {{ 'objets'|trans }}
                    {% if level.spriteSet %}· {{ 'sprites'|trans }} <a href="{{ path('sprites', {id: level.spriteSet.id}) }}">{{ level.spriteSet.name }}</a>{% endif %}
                    {% if not level.public %}· <span class="badge off">{{ 'Privé'|trans }}</span>{% endif %}
                </p>
            </div>
            <div class="lv-actions">
                <a class="play small lv-play" href="{{ path('level_play', {id: level.id}) }}">▶ {{ 'Jouer'|trans }}</a>
                <button type="button" class="pill-button" data-zoom="0.5" aria-label="{{ 'Dézoomer'|trans }}">−</button>
                <button type="button" class="pill-button" data-zoom="2" aria-label="{{ 'Zoomer'|trans }}">+</button>
                <label class="small"><input type="checkbox" data-toggle="collisions"> {{ 'Collisions'|trans }}</label>
                {% if creation_info(level).canEdit %}
                    <a class="pill-button" href="{{ path('level_edit', {id: level.id}) }}">{{ 'Éditer'|trans }}</a>
                {% elseif app.user %}
                    <form method="post" action="{{ path('level_copy', {id: level.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
                        <button class="pill-button pc-hide" type="submit" title="{{ 'Faire ta propre copie, que tu modifies comme tu veux. Le créateur reste cité.'|trans }}">{{ 'Forker'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
        {% import '_parts/cards.html.twig' as cards %}
        {% import '_parts/icons.html.twig' as icons %}
        {% set opinion = level_opinion(level) %}
        <div class="lv-rate">
            {{ cards.numbers(level) }}
            {% for flash in app.flashes('rating') %}<span class="flash error small">{{ flash|trans }}</span>{% endfor %}
            {% if app.user and opinion.refused is null %}
                <form method="post" action="{{ path('level_vote', {id: level.id}) }}" aria-label="{{ 'Ta note'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('rating') }}">
                    <span class="small">{{ 'Ta note'|trans }}</span>
                    {% for n in 1..5 %}
                        <button class="lv-star{{ n <= opinion.stars ? ' on' }}" type="submit" name="stars" value="{{ n }}" aria-pressed="{{ n == opinion.stars ? 'true' : 'false' }}"
                                title="{{ n > 1 ? '%n% étoiles'|trans({'%n%': n}) : '%n% étoile'|trans({'%n%': n}) }}" aria-label="{{ n > 1 ? '%n% étoiles'|trans({'%n%': n}) : '%n% étoile'|trans({'%n%': n}) }}">{{ icons.icon('star') }}</button>
                    {% endfor %}
                    {% if opinion.stars %}<button class="pill-button small" type="submit" name="stars" value="0">{{ 'Retirer ma note'|trans }}</button>{% endif %}
                </form>
            {% elseif not app.user and level.public %}
                <span class="small muted"><a href="{{ path('login', {next: app.request.pathInfo}) }}">{{ 'Connecte-toi'|trans }}</a> {{ 'pour le noter et le mettre dans tes favoris.'|trans }}</span>
            {% elseif opinion.refused and app.user %}
                <span class="small muted">{{ opinion.refused|trans }}</span>
            {% endif %}
            {{ cards.favourite(level, true) }}
        </div>
        <div class="lv-box view"></div>
        <p class="small muted">{{ 'Fais glisser pour te déplacer dans le niveau.'|trans }} <a href="{{ path('levels') }}">{{ 'Tous les niveaux'|trans }}</a></p>
    </section>
    <section class="panel wide">
        <h2>{{ 'Meilleurs temps'|trans }}</h2>
        {% if records is empty %}
            <p class="muted">{{ 'Pas encore de temps : termine-le dans le jeu (connecté à ton compte) pour être le premier.'|trans }}</p>
        {% else %}
            <ol class="lv-records">
                {% for record in records %}
                    <li{% if app.user and record.user == app.user %} class="me"{% endif %}>
                        <span class="lv-rank">{{ loop.index }}</span>
                        <span class="lv-who">{{ people.user(record.user) }}</span>
                        <b class="lv-time">{{ record.time|record_time }}</b>
                        <small class="muted">{{ record.createdAt|date('d/m/Y') }}</small>
                        {% if record.replay %}<a class="small" href="{{ watch ~ record.replay.id }}">{{ 'Revoir'|trans }}</a>{% endif %}
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
        {% if myRecord and myRecord not in records %}<p class="small">{{ 'Ton meilleur temps : %t%'|trans({'%t%': myRecord.time|record_time}) }}</p>{% endif %}
        <p class="small muted">{{ 'Les temps comptent sur le niveau tel qu\'il est : quand son créateur change ses blocs ou ses objets, le classement repart de zéro. Le fantôme du record court avec toi dans le jeu (option Fantôme).'|trans }}</p>
    </section>
    {% include '_parts/credits.html.twig' with {creation: level} only %}
{% else %}
    <p class="pc-only panel wide">{{ 'L\'éditeur se fait sur un ordinateur, avec une souris et un clavier.'|trans }}
        <a href="{{ path('level', {id: level.id}) }}">{{ 'Voir le niveau'|trans }}</a></p>
    <section id="level-editor" class="editor pc-hide" {{ live_attributes(level, restored) }}
             data-json="{{ path('level_json', {id: level.id, version: restored}) }}" data-save="{{ path('level_save', {id: level.id}) }}"
             data-tileset-json="{{ path('tileset_json', {id: 0})|replace({'/0.json': '/ID.json'}) }}"
             data-tileset-page="{{ path('tileset', {id: 0})|replace({'/0': '/ID'}) }}"
             data-token="{{ csrf_token('editor') }}" data-sonic="{{ asset('img/sonics.png') }}"
             data-shapes="{{ asset('data/solidity-shapes.json') }}"
             data-icons="{{ asset('data/object-icons.json') }}" data-icons-image="{{ asset('img/objects.png') }}"
             data-objects="{{ objects|json_encode }}" data-play="{{ path('level_play', {id: level.id}) }}"
             data-i18n="{{ {unsaved: 'Modifications non enregistrées'|trans, saving: 'Enregistrement…'|trans, saved: 'Enregistré'|trans, error: 'Erreur'|trans, block: 'bloc'|trans,
                 selected: '%n% objets sélectionnés'|trans, source: 'Clic droit (ou Alt+clic) : choisis d\'abord la source à copier.'|trans}|json_encode }}">
        <div class="ed-bar">
            <input type="text" name="name" value="{{ level.name }}" maxlength="40" aria-label="{{ 'Nom'|trans }}">
            <label><input type="checkbox" name="public" {{ level.public ? 'checked' }}> {{ 'Public'|trans }}</label>
            <label>♪ <select name="music" aria-label="{{ 'Musique'|trans }}">
                <optgroup label="{{ 'Musiques du jeu'|trans }}">
                    {% for index, name in musics %}<option value="{{ index }}"{% if not level.musicSound and index == level.music %} selected{% endif %}>{{ name|trans }}</option>{% endfor %}
                </optgroup>
                {% if musicSounds is not empty or level.musicSound %}
                    <optgroup label="{{ 'Musiques de l\'éditeur de sons'|trans }}">
                        {% for sound in musicSounds %}<option value="s{{ sound.id }}"{% if level.musicSound and level.musicSound.id == sound.id %} selected{% endif %}>{{ sound.name }}{% if sound.user != app.user %} ({{ sound.user.username }}){% endif %}</option>{% endfor %}
                        {% if level.musicSound and level.musicSound not in musicSounds %}<option value="s{{ level.musicSound.id }}" selected>{{ level.musicSound.name }}</option>{% endif %}
                    </optgroup>
                {% endif %}
            </select></label>
            <label title="{{ 'Les sprites du jeu, ou un de tes jeux de sprites'|trans }}">{{ 'Sprites'|trans }} <select name="sprites" aria-label="{{ 'Sprites'|trans }}">
                <option value="">{{ 'ceux du jeu'|trans }}</option>
                {% for set in spriteSets %}<option value="{{ set.id }}"{% if level.spriteSet and level.spriteSet.id == set.id %} selected{% endif %}>{{ set.name }}{% if set.user != app.user %} ({{ set.user.username }}){% endif %}</option>{% endfor %}
                {% if level.spriteSet and level.spriteSet not in spriteSets %}<option value="{{ level.spriteSet.id }}" selected>{{ level.spriteSet.name }}</option>{% endif %}
            </select></label>
            <span class="ed-sep"></span>
            <button type="button" class="pill-button ed-undo" title="Ctrl+Z">↶</button>
            <button type="button" class="pill-button ed-redo" title="Ctrl+Y">↷</button>
            <button type="button" class="pill-button" data-zoom="-1" title="-">−</button>
            <span class="ed-zoom">100 %</span>
            <button type="button" class="pill-button" data-zoom="1" title="+">+</button>
            <label title="G"><input type="checkbox" data-toggle="grid" checked> {{ 'Grille'|trans }}</label>
            <label title="C"><input type="checkbox" data-toggle="collisions"> {{ 'Collisions'|trans }}</label>
            <span class="ed-sep"></span>
            <span class="ed-status" role="status"></span>
            <a class="pill-button" href="{{ path('level', {id: level.id}) }}" target="_blank">{{ 'Voir'|trans }}</a>
            <button type="button" class="pill-button ed-test" title="{{ 'Enregistre, puis ouvre le jeu sur ce niveau'|trans }}">▶ {{ 'Tester'|trans }}</button>
            <button type="button" class="play small ed-save" title="Ctrl+S">{{ 'Enregistrer'|trans }}</button>
        </div>
        <div class="ed-main">
            <div class="lv-box"></div>
            <aside class="ed-side">
                <div class="ed-tools">
                    <button type="button" data-tool="pencil" title="B">✎ {{ 'Crayon'|trans }}</button>
                    <button type="button" data-tool="rect" title="R">▭ {{ 'Rectangle'|trans }}</button>
                    <button type="button" data-tool="fill" title="F">◧ {{ 'Remplir'|trans }}</button>
                    <button type="button" data-tool="picker" title="I">⌖ {{ 'Pipette'|trans }}</button>
                    <button type="button" data-tool="eraser" title="E">⌫ {{ 'Gomme'|trans }}</button>
                    <button type="button" data-tool="start" title="S">◉ {{ 'Départ'|trans }}</button>
                    <button type="button" data-tool="select" title="V">⬚ {{ 'Sélection'|trans }}</button>
                    <button type="button" data-tool="clone" title="K">⧉ {{ 'Clone'|trans }}</button>
                </div>
                <div class="ed-clone" hidden>
                    <p class="small">{{ 'Clic droit (ou Alt+clic) : la source. Puis peins ailleurs : les blocs de la source (encadrée en bleu) sont recopiés.'|trans }}</p>
                    <div class="ed-row">
                        <label class="small">{{ 'Taille'|trans }} <select name="clone-size">
                            {% for n in 1..5 %}<option value="{{ n }}">{{ n }}×{{ n }}</option>{% endfor %}
                        </select></label>
                        <label class="small" title="{{ 'Coché : la source garde la même distance d\'un trait à l\'autre. Décoché : chaque trait repart de la source.'|trans }}"><input type="checkbox" name="clone-aligned" checked> {{ 'Aligné'|trans }}</label>
                        <label class="small"><input type="checkbox" name="clone-objects" checked> {{ 'avec les objets'|trans }}</label>
                    </div>
                </div>
                <div class="ed-selection" hidden>
                    <p class="small ed-selection-text"></p>
                    <div class="ed-row">
                        <button type="button" class="pill-button ed-selection-replace" title="{{ 'Remplacer par l\'objet choisi dans la liste'|trans }}">{{ 'Remplacer'|trans }}</button>
                        <button type="button" class="pill-button danger ed-selection-delete" title="Suppr">{{ 'Supprimer'|trans }}</button>
                    </div>
                    <p class="small muted">{{ 'Glisser : déplacer (Ctrl : copier). Flèches : d\'un bloc. Ctrl+D : dupliquer. Suppr : enlever. Échap : désélectionner.'|trans }}</p>
                </div>
                <h3>{{ 'Tiles'|trans }} <small class="ed-block muted"></small></h3>
                <div class="ed-row">
                    <select name="tileset" aria-label="{{ 'Tiles'|trans }}">
                        {% for tileset in usable %}<option value="{{ tileset.id }}">{{ tileset.name }}{% if tileset.user and tileset.user != app.user %} ({{ tileset.user.username }}){% endif %}</option>{% endfor %}
                        {% if level.tileset not in usable %}<option value="{{ level.tileset.id }}">{{ level.tileset.name }}</option>{% endif %}
                    </select>
                    <a class="ed-tileset-link small" href="#" target="_blank">{{ 'voir'|trans }}</a>
                </div>
                <div class="ed-palette-box"><canvas class="ed-palette"></canvas></div>
                <details class="ed-objects-box">
                    <summary><h3>{{ 'Objets'|trans }}</h3> <small class="muted">O · {{ 'clic droit : enlever'|trans }}</small></summary>
                    <div class="ed-objects"></div>
                </details>
                <details class="ed-sfx">
                    <summary><h3>{{ 'Bruitages'|trans }}</h3></summary>
                    <p class="small muted">{{ 'Remplace des sons du jeu par tes bruitages (éditeur de sons) dans ce niveau.'|trans }}</p>
                    {% for index, name in gameSfx %}
                        <label class="small">{{ name|trans }}
                            <select data-sfx="{{ index }}">
                                <option value="">{{ 'celui du jeu'|trans }}</option>
                                {% for sound in sfxSounds %}<option value="{{ sound.id }}"{% if level.sfx[index] is defined and level.sfx[index] == sound.id %} selected{% endif %}>{{ sound.name }}{% if sound.user != app.user %} ({{ sound.user.username }}){% endif %}</option>{% endfor %}
                                {% if level.sfx[index] is defined and level.sfx[index] not in sfxSounds|map(s => s.id) %}<option value="{{ level.sfx[index] }}" selected>#{{ level.sfx[index] }}</option>{% endif %}
                            </select></label>
                    {% endfor %}
                    {% if sfxSounds is empty %}<p class="small"><a href="{{ path('editor') }}#sounds">{{ 'Crée d\'abord un bruitage.'|trans }}</a></p>{% endif %}
                </details>
                <details>
                    <summary><h3>{{ 'Taille'|trans }}</h3></summary>
                    <div class="ed-row">
                        <input type="number" name="width" min="8" max="256" aria-label="{{ 'Largeur'|trans }}"> ×
                        <input type="number" name="height" min="6" max="256" aria-label="{{ 'Hauteur'|trans }}">
                        <select name="anchor" aria-label="{{ 'Ancrage'|trans }}">
                            <option value="bottom">{{ 'garder le bas'|trans }}</option>
                            <option value="top">{{ 'garder le haut'|trans }}</option>
                        </select>
                        <button type="button" class="pill-button ed-resize">OK</button>
                    </div>
                    <p class="small muted">{{ '%n% blocs au plus (256 de côté).'|trans({'%n%': 16384}) }}</p>
                </details>
                <details>
                    <summary><h3>{{ 'Aide'|trans }}</h3></summary>
                    <ul class="small ed-help">
                        <li>{{ 'Clic gauche : l\'outil. Clic droit : prendre le bloc sous la souris.'|trans }}</li>
                        <li>{{ 'Molette : défiler (Maj : de côté). Ctrl + molette : zoom.'|trans }}</li>
                        <li>{{ 'Espace + glisser, ou bouton du milieu : déplacer la vue.'|trans }}</li>
                        <li>{{ 'Ctrl+Z / Ctrl+Y : annuler / refaire. Ctrl+S : enregistrer.'|trans }}</li>
                        <li>{{ 'Les collisions (C) montrent en rouge où Sonic marche ; un carré jaune : bloc devant Sonic.'|trans }}</li>
                        <li>{{ 'Objets (O) : clic pour poser (on peut glisser aussitôt), clic sur un objet pour le déplacer, Maj+clic ou clic droit pour l\'enlever.'|trans }}</li>
                        <li>{{ 'Sélection (V) : clic ou rectangle pour choisir des objets, puis glisser, flèches, Ctrl+D, Suppr.'|trans }}</li>
                        <li>{{ 'Clone (K) : clic droit sur la source, puis peins ailleurs : la source suit le pinceau.'|trans }}</li>
                    </ul>
                    {% if level.isOwnedBy(app.user) %}
                    <form method="post" action="{{ path('level_delete', {id: level.id}) }}" onsubmit="return confirm(this.dataset.confirm)"
                          data-confirm="{{ 'Mettre ce niveau à la corbeille ? Tu pourras le restaurer pendant 30 jours. Ses forks restent.'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
                        <button class="pill-button danger" type="submit">{{ 'Mettre à la corbeille'|trans }}</button>
                    </form>
                    {% endif %}
                </details>
                <p class="ed-pos small muted"></p>
            </aside>
        </div>
    </section>
{% endif %}
{% endblock %}

{% block scripts %}
    <script src="{{ asset('js/level-view.js') }}" defer></script>
    {% if edit %}<script src="{{ asset('js/editor-live.js') }}" defer></script>{% endif %}
    {% if edit %}<script src="{{ asset('js/editor-level.js') }}" defer></script>{% endif %}
{% endblock %}
