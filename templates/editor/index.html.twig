{% extends 'base.html.twig' %}

{% block title %}{{ 'Éditeur de niveau'|trans }} · Sonic PHP{% endblock %}
{% block description %}{{ 'Crée tes niveaux de Sonic bloc par bloc, et tes propres tiles. Regarde les niveaux publics des autres joueurs.'|trans }}{% endblock %}

{% block main_class %}wide{% endblock %}
{% import '_parts/cards.html.twig' as cards %}

{% block body %}
<section class="panel wide">
    <h1>{{ 'Éditeur de niveau'|trans }}</h1>
    <p>{{ 'Dessine ta zone bloc par bloc avec les tiles des zones du jeu ou les tiennes, place les anneaux, les badniks, les moniteurs et le départ de Sonic. Publie-la : tout le monde pourra la voir, même sans compte.'|trans }}</p>
    <p class="muted small">{{ 'Chaque niveau se joue dans le jeu : bouton Jouer, ou Tester pendant que tu le fais.'|trans }}</p>
    <p class="pc-only">{{ 'L\'éditeur se fait sur un ordinateur, avec une souris et un clavier. Sur ton téléphone, tu peux regarder les niveaux publics.'|trans }}</p>
    {% for flash in app.flashes('editor') %}<p class="flash error">{{ flash.m|trans({'%n%': flash.n}) }}</p>{% endfor %}
</section>

{% if app.user %}
    <section class="duo">
        <form class="panel form" method="post" action="{{ path('level_new') }}">
            <h2>{{ 'Nouveau niveau'|trans }}</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
            <label for="new-name">{{ 'Nom'|trans }}</label>
            <input type="text" id="new-name" name="name" maxlength="40" required placeholder="{{ 'Ma zone'|trans }}">
            <label for="new-template">{{ 'Partir de'|trans }}</label>
            <select id="new-template" name="template" onchange="this.form.querySelector('.ed-only-empty').hidden = this.value !== ''">
                <option value="">{{ 'Un niveau vide'|trans }}</option>
                {% for key, template in templates %}<option value="{{ key }}">{{ 'Copie de %name%'|trans({'%name%': template.name}) }}</option>{% endfor %}
            </select>
            <div class="ed-only-empty">
                <label for="new-tileset">{{ 'Tiles'|trans }}</label>
                <select id="new-tileset" name="tileset">
                    {% for tileset in usable %}<option value="{{ tileset.id }}">{{ tileset.name }}{% if tileset.user and tileset.user != app.user %} ({{ tileset.user.username }}){% endif %}</option>{% endfor %}
                </select>
            </div>
            <button type="submit" class="play small">{{ 'Créer'|trans }}</button>
        </form>
        <form class="panel form" method="post" action="{{ path('tileset_new') }}">
            <h2>{{ 'Nouveau jeu de tiles'|trans }}</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
            <label for="tiles-name">{{ 'Nom'|trans }}</label>
            <input type="text" id="tiles-name" name="name" maxlength="40" required placeholder="{{ 'Mes tiles'|trans }}">
            <p class="small muted">{{ 'Des blocs de 32×32 pixels (256 au plus), chacun avec sa forme de collision. Pour partir des tiles d\'une zone ou d\'un autre joueur : « Copier » sur leur page.'|trans }}</p>
            <button type="submit" class="play small">{{ 'Créer'|trans }}</button>
        </form>
        <form class="panel form" method="post" action="{{ path('sprites_new') }}">
            <h2>{{ 'Nouveau jeu de sprites'|trans }}</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
            <label for="sprites-name">{{ 'Nom'|trans }}</label>
            <input type="text" id="sprites-name" name="name" maxlength="40" required placeholder="{{ 'Mes sprites'|trans }}">
            <p class="small muted">{{ 'Redessine Sonic, les badniks, les objets ou les boss, pixel par pixel. Un niveau qui les choisit se joue avec eux.'|trans }}</p>
            <button type="submit" class="play small">{{ 'Créer'|trans }}</button>
        </form>
        <form class="panel form" method="post" action="{{ path('sound_new') }}">
            <h2>{{ 'Nouveau son'|trans }}</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
            <label for="sound-name">{{ 'Nom'|trans }}</label>
            <input type="text" id="sound-name" name="name" maxlength="40" required placeholder="{{ 'Ma musique'|trans }}">
            <label for="sound-kind">{{ 'Sorte'|trans }}</label>
            <select id="sound-kind" name="kind">
                <option value="music">{{ 'Une musique (4 voix, comme la Master System)'|trans }}</option>
                <option value="sfx">{{ 'Un bruitage (saut, anneau, explosion…)'|trans }}</option>
            </select>
            <p class="small muted">{{ 'Compose une musique note par note ou fabrique un bruitage, écoute-les, télécharge-les en WAV, et mets-les dans tes niveaux.'|trans }}</p>
            <button type="submit" class="play small">{{ 'Créer'|trans }}</button>
        </form>
    </section>

    <section class="panel wide">
        <div class="lv-head">
            <h2>{{ 'Mes niveaux'|trans }}</h2>
            {% if myLevels|length > 8 %}<a class="pill-button" href="{{ path('levels', {vue: 'miens'}) }}">{{ 'Tous mes niveaux (%n%)'|trans({'%n%': myLevels|length}) }} →</a>{% endif %}
        </div>
        {% if myLevels is empty %}<p class="muted">{{ 'Pas encore de niveau.'|trans }}</p>{% endif %}
        {# the latest changed; all of them, searched: /niveaux?vue=miens #}
        <ul class="ed-cards">{% for level in myLevels|slice(0, 8) %}{{ cards.level_card(level, true) }}{% endfor %}</ul>
    </section>
    <section class="panel wide">
        <h2>{{ 'Mes tiles'|trans }}</h2>
        {% if myTilesets is empty %}<p class="muted">{{ 'Pas encore de tiles à toi.'|trans }}</p>{% endif %}
        <ul class="ed-cards">{% for tileset in myTilesets %}{{ cards.tileset_card(tileset, true) }}{% endfor %}</ul>
    </section>
    <section class="panel wide">
        <h2>{{ 'Mes sprites'|trans }}</h2>
        {% if mySprites is empty %}<p class="muted">{{ 'Pas encore de sprites à toi.'|trans }}</p>{% endif %}
        <ul class="ed-cards">{% for set in mySprites %}{{ cards.sprites_card(set, true) }}{% endfor %}</ul>
    </section>
    <section class="panel wide">
        <h2 id="sounds">{{ 'Mes sons'|trans }}</h2>
        {% if mySounds is empty %}<p class="muted">{{ 'Pas encore de son à toi.'|trans }}</p>{% endif %}
        {{ cards.sound_groups(mySounds, true) }}
    </section>
    {% if shared is not empty %}
    <section class="panel wide">
        <h2 id="shared">{{ 'Partagés avec moi'|trans }}</h2>
        <p class="small muted">{{ 'Leur créateur t\'a ajouté : tu peux les modifier avec lui.'|trans }}</p>
        <ul class="ed-cards">{% for s in shared %}
            {% if s.kind == 'level' %}{{ cards.level_card(s.creation, true) }}{% elseif s.kind == 'tileset' %}{{ cards.tileset_card(s.creation, true) }}{% elseif s.kind == 'sprites' %}{{ cards.sprites_card(s.creation, true) }}{% else %}{{ cards.sound_card(s.creation, true) }}{% endif %}
        {% endfor %}</ul>
    </section>
    {% endif %}
{% else %}
    <section class="panel wide">
        <p>{{ 'Pour créer des niveaux, des tiles, des sprites et des sons :'|trans }}
            <a href="{{ path('register', {next: path('editor')}) }}">{{ 'crée ton compte'|trans }}</a> {{ 'ou'|trans }}
            <a href="{{ path('login', {next: path('editor')}) }}">{{ 'connecte-toi'|trans }}</a>.</p>
    </section>
{% endif %}

<section class="panel wide">
    <div class="lv-head">
        <h2>{{ 'Les mieux notés'|trans }}</h2>
        <a class="pill-button" href="{{ path('levels') }}">{{ 'Tous les niveaux'|trans }} →</a>
    </div>
    {% if publicLevels is empty %}<p class="muted">{{ 'Aucun niveau public pour le moment.'|trans }}</p>{% endif %}
    <ul class="ed-cards">{% for level in publicLevels %}{{ cards.level_card(level, app.user and level.user == app.user) }}{% endfor %}</ul>
    <p class="small"><a href="{{ path('levels', {tri: 'new'}) }}">{{ 'Nouveautés'|trans }}</a> · <a href="{{ path('levels', {tri: 'plays'}) }}">{{ 'Plus joués'|trans }}</a>{% if app.user %} · <a href="{{ path('levels', {vue: 'favoris'}) }}">{{ 'Mes favoris'|trans }}</a>{% endif %}</p>
</section>

<section class="panel wide">
    <h2>{{ 'Tiles'|trans }}</h2>
    <ul class="ed-cards">
        {% for tileset in zones %}{{ cards.tileset_card(tileset, false) }}{% endfor %}
        {% for tileset in publicTilesets %}{{ cards.tileset_card(tileset, app.user and tileset.user == app.user) }}{% endfor %}
    </ul>
</section>

{% if publicSprites is not empty %}
<section class="panel wide">
    <h2>{{ 'Sprites publics'|trans }}</h2>
    <ul class="ed-cards">{% for set in publicSprites %}{{ cards.sprites_card(set, false) }}{% endfor %}</ul>
</section>
{% endif %}

{% if publicSounds is not empty %}
<section class="panel wide">
    <h2>{{ 'Sons publics'|trans }}</h2>
    {{ cards.sound_groups(publicSounds, false) }}
</section>
{% endif %}
{% endblock %}

{% block scripts %}
    {% if mySounds is not empty or publicSounds is not empty %}<script src="{{ asset('js/sound-engine.js') }}" defer></script>{% endif %}
{% endblock %}

