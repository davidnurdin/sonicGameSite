<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#1440c8">
    {# the site is dark already: no "forced dark mode" of the browser (Mi browser, Android WebViews...) #}
    <meta name="color-scheme" content="dark">
    {%- set page_title = block('title') is defined ? block('title')|trim : 'Sonic PHP' -%}
    {%- set page_description = block('description') is defined ? block('description')|trim : '' -%}
    {%- set page_description = page_description ?: 'Sonic PHP : le Sonic de la Master System réécrit en PHP, jouable dans le navigateur, seul ou en ligne.'|trans -%}
    {%- set page_url = app.request.schemeAndHttpHost ~ app.request.pathInfo -%}
    {%- set own_image = block('og_image') is defined ? block('og_image')|trim : '' -%}
    {%- set page_image = own_image ?: app.request.schemeAndHttpHost ~ asset('img/og-' ~ app.request.locale ~ '.png') %}
    <title>{% block title %}Sonic PHP{% endblock %}</title>
    <meta name="description" content="{{ page_description }}">
    <link rel="canonical" href="{{ page_url }}">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Sonic PHP">
    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:description" content="{{ page_description }}">
    <meta property="og:url" content="{{ page_url }}">
    <meta property="og:image" content="{{ page_image }}">
    {% if not own_image %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {% endif %}
    <meta property="og:image:alt" content="{{ 'Sonic PHP : des Sonic de toutes les couleurs à Green Hill'|trans }}">
    <meta property="og:locale" content="{{ app.request.locale == 'fr' ? 'fr_FR' : 'en_US' }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title }}">
    <meta name="twitter:description" content="{{ page_description }}">
    <meta name="twitter:image" content="{{ page_image }}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='34' fill='none' stroke='%23ffd400' stroke-width='16'/></svg>">
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">
</head>
<body>
    <canvas class="sonics" aria-hidden="true" data-sheet="{{ asset('img/sonics.png') }}" data-clouds="{{ asset('img/clouds.png') }}"
            data-presence="{{ path('presence') }}" {% block sonics_attr %}{% endblock %}
            data-i18n="{{ {one: 'visiteur sur le site'|trans, many: 'visiteurs sur le site'|trans, me: 'TOI'|trans}|json_encode }}"></canvas>
    <header class="top">
        <a class="brand" href="{{ path('home') }}"><span class="ring" aria-hidden="true"></span>Sonic PHP</a>
        {% set ingame = online_ingame() %}
        <span class="ingame" title="{{ ingame > 1 ? 'joueurs dans le jeu'|trans : 'joueur dans le jeu'|trans }}"><span class="dot" aria-hidden="true"></span>{{ ingame }}</span>
        {# every page of the site in one menu (a lot of links, small screens): opens without JavaScript #}
        <details class="menu">
            <summary aria-label="{{ 'Menu'|trans }}">
                {%- if app.user %}<span class="who">{{ app.user.username }}</span>{% endif -%}
                <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
            </summary>
            <nav class="menu-panel">
                {% set route = app.request.attributes.get('_route') %}
                <a href="{{ path('home') }}"{% if route == 'home' %} aria-current="page"{% endif %}>{{ app.user ? 'Salons'|trans : 'Accueil'|trans }}</a>
                <a href="{{ path('play') }}">{{ 'Jouer'|trans }}</a>
                <a href="{{ path('members') }}"{% if route == 'members' %} aria-current="page"{% endif %}>{{ 'Joueurs'|trans }}</a>
                <a href="{{ path('history') }}"{% if route == 'history' %} aria-current="page"{% endif %}>{{ 'Historique'|trans }}</a>
                {% if app.user %}
                    <a href="{{ path('stats') }}"{% if route == 'stats' %} aria-current="page"{% endif %}>{{ 'Statistiques'|trans }}</a>
                {% endif %}
                <a href="{{ path('editor') }}"{% if route == 'editor' %} aria-current="page"{% endif %}>{{ 'Éditeur de niveau'|trans }}</a>
                <a href="{{ path('developers') }}"{% if route == 'developers' %} aria-current="page"{% endif %}>{{ 'API publique'|trans }}</a>
                <hr>
                {% if app.user %}
                    <a href="{{ path('profile', {username: app.user.username}) }}"{% if route == 'profile' %} aria-current="page"{% endif %}>{{ 'Mon profil'|trans }}</a>
                    <a href="{{ path('trash') }}"{% if route == 'trash' %} aria-current="page"{% endif %}>{{ 'Corbeille'|trans }}</a>
                    <a href="{{ path('ai') }}"{% if route in ['ai', 'ai_keys'] %} aria-current="page"{% endif %}>{{ 'IA et clés API'|trans }}</a>
                    <a href="{{ path('logout') }}">{{ 'Déconnexion'|trans }} <small>({{ app.user.username }})</small></a>
                {% else %}
                    {# back to this page once signed in (an invitation to a room...) #}
                    {%- set back_to = route in ['login', 'register'] ? app.request.query.get('next') : app.request.pathInfo -%}
                    {%- if back_to is not same as(null) and (back_to starts with '//' or not (back_to starts with '/') or back_to == '/') %}{% set back_to = null %}{% endif -%}
                    <a href="{{ path('login', back_to ? {next: back_to} : {}) }}">{{ 'Connexion'|trans }}</a>
                    <a class="pill" href="{{ path('register', back_to ? {next: back_to} : {}) }}">{{ 'Inscription'|trans }}</a>
                {% endif %}
                <span class="langs">
                    {%- for l in ['fr', 'en'] -%}
                        <a href="{{ path('lang', {lang: l, back: app.request.requestUri}) }}" hreflang="{{ l }}"
                           {%- if app.request.locale == l %} aria-current="true"{% endif %}>{{ l == 'fr' ? 'Français' : 'English' }}</a>
                    {%- endfor -%}
                </span>
            </nav>
        </details>
    </header>

    <main class="{% block main_class %}{% endblock %}">
        {% for message in app.flashes('success') %}
            <p class="flash">{{ message }}</p>
        {% endfor %}
        {% for message in app.flashes('trash') %}
            <p class="flash">{{ message|trans }}</p>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <footer class="ground">
        <p>
            {{ 'Projet de fan, en PHP :'|trans }} <a href="https://github.com/davidnurdin/sonicGamePhp">{{ 'le jeu'|trans }}</a> ·
            <a href="https://github.com/davidnurdin/php-wasm-sdl">{{ 'le moteur'|trans }}</a> ·
            <a href="https://github.com/davidnurdin/php-wasm-network">{{ 'le réseau'|trans }}</a> ·
            <a href="{{ path('developers') }}">{{ 'API publique'|trans }}</a>
        </p>
        <p class="small">{{ 'Sonic the Hedgehog est une marque de SEGA. Ce site n\'est pas affilié à SEGA.'|trans }}</p>
    </footer>
    <script>
        // the menu closes when one clicks elsewhere, or presses Escape
        document.addEventListener('click', e => { const m = document.querySelector('details.menu[open]'); if (m && !m.contains(e.target)) m.open = false; });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelector('details.menu')?.removeAttribute('open'); });
    </script>
    <script src="{{ asset('js/sonics.js') }}" defer></script>
    {% block scripts %}{% endblock %}
</body>
</html>
