<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#1440c8">
    <meta name="description" content="Sonic PHP : le Sonic de la Master System réécrit en PHP, jouable dans le navigateur, seul ou en ligne.">
    <title>{% block title %}Sonic PHP{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='34' fill='none' stroke='%23ffd400' stroke-width='16'/></svg>">
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">
</head>
<body>
    <canvas class="sonics" aria-hidden="true" data-sheet="{{ asset('img/sonics.png') }}" data-clouds="{{ asset('img/clouds.png') }}" data-presence="{{ path('presence') }}"></canvas>
    <header class="top">
        <a class="brand" href="{{ path('home') }}"><span class="ring" aria-hidden="true"></span>Sonic PHP</a>
        <nav class="account">
            {% if app.user %}
                <span class="who">{{ app.user.username }}</span>
                <a href="{{ path('logout') }}">Déconnexion</a>
            {% else %}
                <a href="{{ path('login') }}">Connexion</a>
                <a class="pill" href="{{ path('register') }}">Inscription</a>
            {% endif %}
        </nav>
    </header>

    <main>
        {% for message in app.flashes('success') %}
            <p class="flash">{{ message }}</p>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <footer class="ground">
        <p>
            Projet de fan, en PHP : <a href="https://github.com/davidnurdin/sonicGamePhp">le jeu</a> ·
            <a href="https://github.com/davidnurdin/php-wasm-sdl">le moteur</a> ·
            <a href="https://github.com/davidnurdin/php-wasm-network">le réseau</a>
        </p>
        <p class="small">Sonic the Hedgehog est une marque de SEGA. Ce site n'est pas affilié à SEGA.</p>
    </footer>
    <script src="{{ asset('js/sonics.js') }}" defer></script>
</body>
</html>
