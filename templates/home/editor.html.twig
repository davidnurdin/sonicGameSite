{% extends 'base.html.twig' %}

{% block title %}{{ 'Éditeur de niveau'|trans }} · Sonic PHP{% endblock %}

{% block body %}
<section class="panel construction">
    <div class="sign" aria-hidden="true"></div>
    <h1>{{ 'Éditeur de niveau'|trans }}</h1>
    <p class="tagline">{{ 'En construction.'|trans }}</p>
    <p>{{ 'Bientôt, tu pourras :'|trans }}</p>
    <ul class="soon">
        <li>{{ 'dessiner ta zone bloc par bloc, avec les décors des zones du jeu ;'|trans }}</li>
        <li>{{ 'placer anneaux, moniteurs, badniks, ressorts et le panneau d\'arrivée ;'|trans }}</li>
        <li>{{ 'la tester tout de suite dans le jeu ;'|trans }}</li>
        <li>{{ 'la publier et jouer à celles des autres, seul ou en ligne.'|trans }}</li>
    </ul>
    <a class="play small" href="{{ path('play') }}">{{ 'En attendant, jouer'|trans }}</a>
</section>
{% endblock %}
