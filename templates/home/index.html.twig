{% extends 'base.html.twig' %}

{% block body %}
<section class="hero">
    <h1>Sonic PHP</h1>
    <p class="tagline">{{ 'Le Sonic de la Master System, réécrit en PHP, dans ton navigateur.'|trans }}</p>

    <a class="play" href="{{ path('play') }}">{{ 'Jouer'|trans }}</a>

    <p class="as">
        <a href="{{ path('register') }}">{{ 'Crée un compte'|trans }}</a> {{ 'en 10 secondes : ton nom dans les parties en ligne, les salons du site et tes statistiques.'|trans }}
    </p>

    {% include '_parts/online.html.twig' %}
</section>

<section class="cards">
    <article class="card">
        <h2>{{ 'Seul'|trans }}</h2>
        <p>{{ 'Les zones du jeu d\'origine, des meilleurs temps et un fantôme pour battre ton record.'|trans }}</p>
    </article>
    <article class="card">
        <h2>{{ 'En ligne'|trans }}</h2>
        <p>{{ 'Course, drapeau, anneaux ou deathmatch jusqu\'à 6, niveaux bonus compris : un salon public avec qui veut, ou un salon privé pour tes amis, ici ou dans le jeu (Multijoueur → En ligne).'|trans }}</p>
    </article>
    <article class="card">
        <h2>{{ 'Éditeur de niveau'|trans }}</h2>
        <p>{{ 'Crée tes propres zones et partage-les.'|trans }} <a href="{{ path('editor') }}">{{ 'Bientôt'|trans }}</a>.</p>
    </article>
</section>

{% include 'home/_howto.html.twig' %}
{% endblock %}
