{% extends 'base.html.twig' %}

{% block title %}{{ 'Connexion'|trans }} · Sonic PHP{% endblock %}
{% block robots %}noindex, follow{% endblock %}

{% block body %}
<section class="panel">
    <h1>{{ 'Connexion'|trans }}</h1>
    {% if error %}
        <p class="error">
            {%- if error.messageKey starts with 'Too many' -%} {{ 'Trop d\'essais : réessaie dans une minute.'|trans }}
            {%- elseif error.messageKey starts with 'Invalid CSRF' -%} {{ 'La page a expiré, réessaie.'|trans }}
            {%- else -%} {{ 'Nom ou mot de passe incorrect.'|trans }}
            {%- endif -%}
        </p>
    {% endif %}
    <form method="post" action="{{ path('login') }}" class="form">
        <label for="username">{{ 'Nom de joueur'|trans }}</label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username"
               autocapitalize="characters" spellcheck="false" maxlength="15" required autofocus>

        <label for="password">{{ 'Mot de passe'|trans }}</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        {% if next %}<input type="hidden" name="_target_path" value="{{ next }}">{% endif %}
        <button type="submit" class="play small">{{ 'Se connecter'|trans }}</button>
    </form>
    <p class="alt">{{ 'Pas encore de compte ?'|trans }} <a href="{{ path('register', next ? {next: next} : {}) }}">{{ 'Inscription'|trans }}</a></p>
</section>
{% endblock %}
