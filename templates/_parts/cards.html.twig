{# The cards of the creations, in the editor's hub and on the profiles (mine: the viewer may edit it). #}
{% macro level_card(level, mine) %}
    {% import '_parts/people.html.twig' as people %}
    <li class="ed-card">
        <a class="ed-thumb" href="{{ path(mine ? 'level_edit' : 'level', {id: level.id}) }}">
            <img src="{{ path('level_png', {id: level.id, v: level.updatedAt.timestamp}) }}" alt="" loading="lazy">
        </a>
        <div class="ed-card-text">
            <b>{{ level.name }}</b>
            <small class="muted">
                {% if not mine %}{{ 'par'|trans }} {{ people.user(level.user) }} · {% endif %}
                {{ level.width }}×{{ level.height }} · {{ level.tileset.name }}
            </small>
            {% if mine %}<span class="badge{% if not level.public %} off{% endif %}">{{ level.public ? 'Public'|trans : 'Privé'|trans }}</span>{% endif %}
        </div>
        <div class="ed-card-go">
            <a class="pill-button play-pill" href="{{ path('level_play', {id: level.id}) }}">▶ {{ 'Jouer'|trans }}</a>
            {% if mine %}<a class="pill-button" href="{{ path('level_edit', {id: level.id}) }}">{{ 'Éditer'|trans }}</a>{% endif %}
            <a class="pill-button" href="{{ path('level', {id: level.id}) }}">{{ 'Voir'|trans }}</a>
        </div>
    </li>
{% endmacro %}

{% macro tileset_card(tileset, mine) %}
    {% import '_parts/people.html.twig' as people %}
    <li class="ed-card tiles">
        <a class="ed-thumb" href="{{ path(mine ? 'tileset_edit' : 'tileset', {id: tileset.id}) }}">
            <img src="{{ path('tileset_png', {id: tileset.id, v: tileset.updatedAt.timestamp}) }}" alt="" loading="lazy">
        </a>
        <div class="ed-card-text">
            <b>{{ tileset.name }}</b>
            <small class="muted">
                {% if tileset.zone %}{{ 'Zone du jeu'|trans }} · {% elseif not mine %}{{ 'par'|trans }} {{ people.user(tileset.user) }} · {% endif %}
                {{ tileset.count }} {{ 'blocs'|trans }}
            </small>
            {% if mine %}<span class="badge{% if not tileset.public %} off{% endif %}">{{ tileset.public ? 'Public'|trans : 'Privé'|trans }}</span>{% endif %}
        </div>
        <div class="ed-card-go">
            {% if mine %}<a class="pill-button" href="{{ path('tileset_edit', {id: tileset.id}) }}">{{ 'Éditer'|trans }}</a>{% endif %}
            <a class="pill-button" href="{{ path('tileset', {id: tileset.id}) }}">{{ 'Voir'|trans }}</a>
        </div>
    </li>
{% endmacro %}

{% macro sprites_card(set, mine) %}
    {% import '_parts/people.html.twig' as people %}
    <li class="ed-card sprites">
        <a class="ed-thumb" href="{{ path(mine ? 'sprites_edit' : 'sprites', {id: set.id}) }}">
            <img src="{{ path('sprites_png', {id: set.id, sheet: 'sonic', v: set.updatedAt.timestamp}) }}" alt="" loading="lazy">
        </a>
        <div class="ed-card-text">
            <b>{{ set.name }}</b>
            <small class="muted">
                {% if not mine %}{{ 'par'|trans }} {{ people.user(set.user) }} · {% endif %}
                {{ set.sheets|length > 1 ? '%n% planches redessinées'|trans({'%n%': set.sheets|length}) : '%n% planche redessinée'|trans({'%n%': set.sheets|length}) }}
            </small>
            {% if mine %}<span class="badge{% if not set.public %} off{% endif %}">{{ set.public ? 'Public'|trans : 'Privé'|trans }}</span>{% endif %}
        </div>
        <div class="ed-card-go">
            {% if mine %}<a class="pill-button" href="{{ path('sprites_edit', {id: set.id}) }}">{{ 'Éditer'|trans }}</a>{% endif %}
            <a class="pill-button" href="{{ path('sprites', {id: set.id}) }}">{{ 'Voir'|trans }}</a>
        </div>
    </li>
{% endmacro %}

{% macro sound_card(sound, mine) %}
    {% import '_parts/people.html.twig' as people %}
    <li class="ed-card sound" data-sound-player data-kind="{{ sound.kind }}" data-sound="{{ sound.data|json_encode }}" data-name="{{ sound.name }}">
        <div class="ed-card-text">
            <b>{{ sound.music ? '♪' : '🔊' }} {{ sound.name }}</b>
            <small class="muted">
                {{ sound.music ? 'Musique'|trans : 'Bruitage'|trans }}{% if not mine %} · {{ 'par'|trans }} {{ people.user(sound.user) }}{% endif %}
                {% if sound.forkedFrom %} · {{ 'fork de'|trans }} {{ sound.forkedFrom.name }}{% endif %}
            </small>
            {% if mine %}<span class="badge{% if not sound.public %} off{% endif %}">{{ sound.public ? 'Public'|trans : 'Privé'|trans }}</span>{% endif %}
        </div>
        <div class="ed-card-go">
            <button type="button" class="pill-button play-pill sd-play">▶</button>
            {% if mine %}<a class="pill-button" href="{{ path('sound_edit', {id: sound.id}) }}">{{ 'Éditer'|trans }}</a>
            {% elseif app.user %}
                <form method="post" action="{{ path('sound_new') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
                    <input type="hidden" name="from" value="{{ sound.id }}">
                    <button class="pill-button pc-hide" type="submit" title="{{ 'Faire ta propre copie, que tu modifies comme tu veux. Le créateur reste cité.'|trans }}">{{ 'Forker'|trans }}</button>
                </form>
            {% endif %}
            <a class="pill-button" href="{{ path('sound', {id: sound.id}) }}">{{ 'Voir'|trans }}</a>
        </div>
    </li>
{% endmacro %}
