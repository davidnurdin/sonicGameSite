{# The cards of the creations, in the editor's hub and on the profiles (mine: the viewer may edit it). #}
{% macro level_card(level, mine) %}
    {% import '_parts/people.html.twig' as people %}
    {% import _self as cards %}
    {% import '_parts/icons.html.twig' as icons %}
    <li class="ed-card">
        <a class="ed-thumb" href="{{ path(mine ? 'level_edit' : 'level', {id: level.id}) }}">
            <img src="{{ path('level_png', {id: level.id, v: level.updatedAt.timestamp}) }}" alt="" loading="lazy">
        </a>
        <div class="ed-card-text">
            <b>{{ level.name }}</b>
            <small class="muted">
                {% if not mine %}{{ 'par'|trans }} {{ people.user(level.user) }} · {% endif %}
                {{ level.width }}×{{ level.height }} · {{ level.tileset.name }}
            </small>
            {{ cards.numbers(level) }}
            {% if mine %}<span class="badge{% if not level.public %} off{% endif %}">{{ level.public ? 'Public'|trans : 'Privé'|trans }}</span>{% endif %}
        </div>
        <div class="ed-card-go">
            <a class="pill-button play-pill icon-only" href="{{ path('level_play', {id: level.id}) }}" aria-label="{{ 'Jouer'|trans }}" title="{{ 'Jouer'|trans }}">{{ icons.icon('play') }}</a>
            {% if mine %}<a class="pill-button icon-only" href="{{ path('level_edit', {id: level.id}) }}" aria-label="{{ 'Éditer'|trans }}" title="{{ 'Éditer'|trans }}">{{ icons.icon('edit') }}</a>{% endif %}
            <a class="pill-button icon-only" href="{{ path('level', {id: level.id}) }}" aria-label="{{ 'Voir'|trans }}" title="{{ 'Voir'|trans }}">{{ icons.icon('view') }}</a>
            {{ cards.favourite(level) }}
            {{ cards.trash('level', level) }}
        </div>
    </li>
{% endmacro %}

{% macro tileset_card(tileset, mine) %}
    {% import '_parts/people.html.twig' as people %}
    {% import _self as cards %}
    {% import '_parts/icons.html.twig' as icons %}
    <li class="ed-card tiles">
        <a class="ed-thumb" href="{{ path(mine ? 'tileset_edit' : 'tileset', {id: tileset.id}) }}">
            <img src="{{ path('tileset_png', {id: tileset.id, v: tileset.updatedAt.timestamp}) }}" alt="" loading="lazy">
        </a>
        <div class="ed-card-text">
            <b>{{ tileset.name }}</b>
            <small class="muted">
                {% if tileset.zone %}{{ 'Zone du jeu'|trans }} · {% elseif not mine %}{{ 'par'|trans }} {{ people.user(tileset.user) }} · {% endif %}
                {{ tileset.count }} {{ 'blocs'|trans }}
            </small>
            {% if mine %}<span class="badge{% if not tileset.public %} off{% endif %}">{{ tileset.public ? 'Public'|trans : 'Privé'|trans }}</span>{% endif %}
        </div>
        <div class="ed-card-go">
            {% if mine %}<a class="pill-button icon-only" href="{{ path('tileset_edit', {id: tileset.id}) }}" aria-label="{{ 'Éditer'|trans }}" title="{{ 'Éditer'|trans }}">{{ icons.icon('edit') }}</a>{% endif %}
            <a class="pill-button icon-only" href="{{ path('tileset', {id: tileset.id}) }}" aria-label="{{ 'Voir'|trans }}" title="{{ 'Voir'|trans }}">{{ icons.icon('view') }}</a>
            {{ cards.trash('tileset', tileset) }}
        </div>
    </li>
{% endmacro %}

{% macro sprites_card(set, mine) %}
    {% import '_parts/people.html.twig' as people %}
    {% import _self as cards %}
    {% import '_parts/icons.html.twig' as icons %}
    <li class="ed-card sprites">
        <a class="ed-thumb" href="{{ path(mine ? 'sprites_edit' : 'sprites', {id: set.id}) }}">
            <img src="{{ path('sprites_png', {id: set.id, sheet: 'sonic', v: set.updatedAt.timestamp}) }}" alt="" loading="lazy">
        </a>
        <div class="ed-card-text">
            <b>{{ set.name }}</b>
            <small class="muted">
                {% if not mine %}{{ 'par'|trans }} {{ people.user(set.user) }} · {% endif %}
                {{ set.sheets|length > 1 ? '%n% planches redessinées'|trans({'%n%': set.sheets|length}) : '%n% planche redessinée'|trans({'%n%': set.sheets|length}) }}
            </small>
            {% if mine %}<span class="badge{% if not set.public %} off{% endif %}">{{ set.public ? 'Public'|trans : 'Privé'|trans }}</span>{% endif %}
        </div>
        <div class="ed-card-go">
            {% if mine %}<a class="pill-button icon-only" href="{{ path('sprites_edit', {id: set.id}) }}" aria-label="{{ 'Éditer'|trans }}" title="{{ 'Éditer'|trans }}">{{ icons.icon('edit') }}</a>{% endif %}
            <a class="pill-button icon-only" href="{{ path('sprites', {id: set.id}) }}" aria-label="{{ 'Voir'|trans }}" title="{{ 'Voir'|trans }}">{{ icons.icon('view') }}</a>
            {{ cards.trash('sprites', set) }}
        </div>
    </li>
{% endmacro %}

{% macro sound_card(sound, mine) %}
    {% import '_parts/people.html.twig' as people %}
    {% import _self as cards %}
    {% import '_parts/icons.html.twig' as icons %}
    <li class="ed-card sound" data-sound-player data-kind="{{ sound.kind }}" data-sound="{{ sound.data|json_encode }}" data-name="{{ sound.name }}">
        <div class="ed-card-text">
            <b>{{ sound.music ? '♪' : '🔊' }} {{ sound.name }}</b>
            <small class="muted">
                {{ sound.music ? 'Musique'|trans : 'Bruitage'|trans }}{% if not mine %} · {{ 'par'|trans }} {{ people.user(sound.user) }}{% endif %}
                {% if sound.forkedFrom %} · {{ 'fork de'|trans }} {{ sound.forkedFrom.name }}{% endif %}
            </small>
            {% if mine %}<span class="badge{% if not sound.public %} off{% endif %}">{{ sound.public ? 'Public'|trans : 'Privé'|trans }}</span>{% endif %}
        </div>
        <div class="ed-card-go">
            <button type="button" class="pill-button play-pill icon-only sd-play" aria-label="{{ 'Écouter'|trans }}" title="{{ 'Écouter'|trans }}">{{ icons.icon('play') }}{{ icons.icon('stop') }}</button>
            {% if mine %}<a class="pill-button icon-only" href="{{ path('sound_edit', {id: sound.id}) }}" aria-label="{{ 'Éditer'|trans }}" title="{{ 'Éditer'|trans }}">{{ icons.icon('edit') }}</a>
            {% elseif app.user %}
                <form method="post" action="{{ path('sound_new') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
                    <input type="hidden" name="from" value="{{ sound.id }}">
                    <button class="pill-button pc-hide icon-only" type="submit" aria-label="{{ 'Forker'|trans }}" title="{{ 'Forker : faire ta propre copie, que tu modifies comme tu veux. Le créateur reste cité.'|trans }}">{{ icons.icon('fork') }}</button>
                </form>
            {% endif %}
            <a class="pill-button icon-only" href="{{ path('sound', {id: sound.id}) }}" aria-label="{{ 'Voir'|trans }}" title="{{ 'Voir'|trans }}">{{ icons.icon('view') }}</a>
            {{ cards.trash('sound', sound) }}
        </div>
    </li>
{% endmacro %}

{# What the players think of a level: its stars (average, votes), its plays, its favourites. #}
{% macro numbers(level) %}
    {% import '_parts/icons.html.twig' as icons %}
    <span class="lv-numbers small">
        <span class="lv-stars" title="{{ level.voteCount ? '%r% sur 5, %n% votes'|trans({'%r%': level.rating, '%n%': level.voteCount}) : 'Pas encore noté'|trans }}">{{ icons.icon('star') }}{{ level.voteCount ? level.rating|number_format(1, ',') ~ ' (' ~ level.voteCount ~ ')' : '–' }}</span>
        <span title="{{ 'Parties'|trans }}">{{ icons.icon('play') }}{{ level.plays }}</span>
        <span title="{{ 'Dans les favoris'|trans }}">{{ icons.icon('heart') }}{{ level.favourites }}</span>
    </span>
{% endmacro %}

{# The heart of a level: in the viewer's favourites, or not (signed in only; back to this page). #}
{% macro favourite(level, labelled = false) %}
    {% import '_parts/icons.html.twig' as icons %}
    {% if app.user and level.public or app.user and level.ownedBy(app.user) %}
        {% set on = is_favourite(level) %}
        {% set label = on ? 'Retirer des favoris'|trans : 'Ajouter aux favoris'|trans %}
        <form class="lv-fav-form" method="post" action="{{ path('level_favourite', {id: level.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('rating') }}">
            <input type="hidden" name="on" value="{{ on ? 0 : 1 }}">
            <input type="hidden" name="back" value="{{ app.request.requestUri }}">
            <button class="pill-button lv-fav{{ on ? ' on' }}{{ labelled ? '' : ' icon-only' }}" type="submit" aria-pressed="{{ on ? 'true' : 'false' }}" aria-label="{{ label }}" title="{{ label }}">{{ icons.icon('heart') }}{% if labelled %}{{ on ? 'Dans tes favoris'|trans : 'Favori'|trans }}{% endif %}</button>
        </form>
    {% endif %}
{% endmacro %}

{# The sounds, the musics apart from the sound effects. #}
{% macro sound_groups(list, mine) %}
    {% import _self as cards %}
    {% for music in [true, false] %}
        {% set group = list|filter(s => s.music == music) %}
        {% if group is not empty %}
            <h3 class="ed-sub">{{ music ? '♪ ' ~ 'Musiques'|trans : '🔊 ' ~ 'Bruitages'|trans }} <small class="muted">{{ group|length }}</small></h3>
            <ul class="ed-cards">{% for sound in group %}{{ cards.sound_card(sound, mine) }}{% endfor %}</ul>
        {% endif %}
    {% endfor %}
{% endmacro %}

{# The red trash of a card: only its creator; asks first, then back to this page (TrashRedirect). #}
{% macro trash(kind, creation) %}
    {% import '_parts/icons.html.twig' as icons %}
    {% if app.user and creation.ownedBy(app.user) and not creation.trashed %}
        <form class="ed-card-trash" method="post" action="{{ path(kind ~ '_delete', {id: creation.id}) }}" onsubmit="return confirm(this.dataset.confirm)"
              data-confirm="{{ 'Mettre « %name% » à la corbeille ? Tu pourras le restaurer pendant 30 jours. Les forks et les niveaux qui l\'utilisent ne changent pas.'|trans({'%name%': creation.name}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('editor') }}">
            <input type="hidden" name="back" value="{{ app.request.requestUri }}">
            <button class="pill-button danger icon-only" type="submit" aria-label="{{ 'Mettre à la corbeille'|trans }}" title="{{ 'Mettre à la corbeille'|trans }}">{{ icons.icon('trash') }}</button>
        </form>
    {% endif %}
{% endmacro %}
