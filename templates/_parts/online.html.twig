{# who is online: the players of the game (relay), the visitors of the site (Mercure, js/sonics.js) #}
<p class="counts">
    <span class="online" id="players"{% if online is null %} hidden{% endif %}><span class="dot" aria-hidden="true"></span>
        <b>{{ online.players ?? 0 }}</b> <span class="label" data-one="{{ 'joueur en ligne'|trans }}" data-many="{{ 'joueurs en ligne'|trans }}">
        {{- (online.players ?? 0) > 1 ? 'joueurs en ligne'|trans : 'joueur en ligne'|trans -}}</span></span>
    <span class="online" id="presence" hidden><span class="dot" aria-hidden="true"></span><b>0</b> <span class="label"></span></span>
    {% if members is defined %}
        <span class="online"><span class="dot member" aria-hidden="true"></span><b>{{ members }}</b>
            {{ members > 1 ? 'membres'|trans : 'membre'|trans }}</span>
    {% endif %}
</p>
